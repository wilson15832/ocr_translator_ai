<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating control bar (design 5a). The five actions and their icons now live in
  ControlWheel.Action rather than as five ImageButtons here, because only one is ever armed and
  the two neighbours are drawn from the same list — a fixed set of children can't express that.
  The CardView chrome is gone too: the wheel carries a drop shadow instead of painting a panel
  over the game.
-->
<com.example.ocr_translation.ui.ControlWheel xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlPanelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp" />
