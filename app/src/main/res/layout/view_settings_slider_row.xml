<?xml version="1.0" encoding="utf-8"?>
<!--
  Inner content of com.example.ocr_translation.ui.SettingsSliderRow: label and value share the
  first line (so the screen scans as one column of names and values) and the slider owns the
  second, instead of the old label-above-slider-beside-value stack.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ssTitleView"
            style="@style/IosRowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ssValueView"
            style="@style/IosRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/ssSlider"
        style="@style/IosSlider"
        android:layout_marginTop="6dp" />
</merge>
