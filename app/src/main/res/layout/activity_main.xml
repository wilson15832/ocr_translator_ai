<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen. Four blocks, top to bottom:
    1. Accent-coloured header band — title + description, contiguous with the status bar
       (MainActivity paints the status bar the same accent, so no inset maths is needed here).
    2. Theme row — the app glyph plus six accent swatches; picking one recreates the activity.
    3. Language card — From / To at 20sp with a swap row underneath.
    4. Start button, then the two settings entries.

  On phones taller than the design's 393x852 reference, fixed margins would leave everything
  crammed into the top half. The weighted spacers absorb that surplus (2:1). A weighted Space
  with height 0dp collapses to nothing when there's no surplus, so the fixed margins still
  define the minimum spacing and short screens fall back to plain scrolling.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- 1. Header band -->
        <!--
          colorPrimaryVariant, not colorPrimary: the raw accents are too light to carry white
          text (white on green/orange is ~2.2:1), while every variant clears 4.5:1.
        -->
        <LinearLayout
            android:id="@+id/headerBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryVariant"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/textAppTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.021"
                android:text="@string/app_name"
                android:textColor="@color/on_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAppDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2sp"
                android:text="@string/app_description"
                android:textColor="#EBFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 2. Accent picker: app glyph + swatches (filled in by MainActivity) -->
        <com.example.ocr_translation.ui.SettingsGroup
            style="@style/IosGroup"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glyph_tile">

                    <ImageView
                        android:id="@+id/imageAppLogo"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_logo"
                        android:src="@drawable/ic_translate"
                        app:tint="?attr/colorOnPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/accentSwatches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.example.ocr_translation.ui.SettingsGroup>

        <!-- A sixth of the surplus, so the top isn't dense while the rest is empty -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 3. Languages -->
        <TextView
            style="@style/IosGroupHeader"
            android:layout_marginTop="24dp"
            android:text="@string/language_settings" />

        <com.example.ocr_translation.ui.SettingsGroup
            android:id="@+id/cardLanguageSettings"
            style="@style/IosGroup"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <com.example.ocr_translation.ui.SettingsRow
                android:id="@+id/rowSourceLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srAccessory="chevron"
                app:srTextSize="20sp"
                app:srTitle="@string/source_language" />

            <com.example.ocr_translation.ui.SettingsRow
                android:id="@+id/rowTargetLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srAccessory="chevron"
                app:srTextSize="20sp"
                app:srTitle="@string/target_language" />

            <com.example.ocr_translation.ui.SettingsRow
                android:id="@+id/rowSwapLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srCenterTitle="true"
                app:srRole="accent"
                app:srTitle="@string/swap_languages"
                app:srTitleIcon="@drawable/ic_swap_vert" />
        </com.example.ocr_translation.ui.SettingsGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTranslation"
            style="@style/IosPrimaryButton"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            android:text="@string/start_translation"
            app:icon="@drawable/ic_start" />

        <!-- The bulk of the surplus -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- 4. Settings entry points -->
        <com.example.ocr_translation.ui.SettingsGroup
            style="@style/IosGroup"
            android:layout_marginStart="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="16dp">

            <com.example.ocr_translation.ui.SettingsRow
                android:id="@+id/cardTranslationSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srAccessory="chevron"
                app:srIcon="@drawable/ic_translate"
                app:srTitle="@string/translation_settings" />

            <com.example.ocr_translation.ui.SettingsRow
                android:id="@+id/cardOverlaySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srAccessory="chevron"
                app:srIcon="@drawable/ic_settings"
                app:srIconBackground="@color/glyph_tile_grey"
                app:srTitle="@string/display_settings" />
        </com.example.ocr_translation.ui.SettingsGroup>

        <TextView
            android:id="@+id/textPermissionsInfo"
            style="@style/IosFootnote"
            android:text="@string/permissions_info" />

        <!-- Keeps the block above off the bottom edge rather than pinned to it -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

    </LinearLayout>
</ScrollView>
