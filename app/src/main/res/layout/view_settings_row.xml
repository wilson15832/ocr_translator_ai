<?xml version="1.0" encoding="utf-8"?>
<!-- Inner content of com.example.ocr_translation.ui.SettingsRow. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- 29dp squircle glyph tile; hidden unless app:srIcon is set -->
    <FrameLayout
        android:id="@+id/srIconTile"
        android:layout_width="29dp"
        android:layout_height="29dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_glyph_tile"
        android:visibility="gone">

        <ImageView
            android:id="@+id/srIconView"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/on_primary" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/srTextColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/srTitleView"
            style="@style/IosRowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/srSubtitleView"
            style="@style/IosRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/srValueView"
        style="@style/IosRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/srChevron"
        android:layout_width="7dp"
        android:layout_height="12dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_ios_chevron_right"
        android:visibility="gone" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/srSwitch"
        style="@style/IosSwitch"
        android:layout_marginStart="12dp"
        android:clickable="false"
        android:duplicateParentState="false"
        android:focusable="false"
        android:visibility="gone" />
</merge>
