<?xml version="1.0" encoding="utf-8"?>
<!--
  The default launcher icon. Kept as its own resource rather than an alias of ic_launcher_blue so
  that `android:icon` on <application> — which is what shows in Settings and the share sheet — does
  not move when the user picks a different home-screen icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_blue" />
    <foreground android:drawable="@drawable/ic_launcher_mark" />
</adaptive-icon>
