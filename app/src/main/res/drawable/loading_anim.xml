<?xml version="1.0" encoding="utf-8"?>
<!--
  Frame animation behind OverlayService.createSpinnerOverlay()'s R.drawable.loading_anim.
  The six frames live in res/drawable-nodpi/; 500ms each gives a 3s cycle.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/frame_1" android:duration="500" />
    <item android:drawable="@drawable/frame_2" android:duration="500" />
    <item android:drawable="@drawable/frame_3" android:duration="500" />
    <item android:drawable="@drawable/frame_4" android:duration="500" />
    <item android:drawable="@drawable/frame_5" android:duration="500" />
    <item android:drawable="@drawable/frame_6" android:duration="500" />
</animation-list>
