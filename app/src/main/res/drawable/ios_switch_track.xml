<?xml version="1.0" encoding="utf-8"?>
<!-- 51x31 track; SwitchCompat swaps the two states. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_switch_on" />
            <corners android:radius="15.5dp" />
            <size android:width="51dp" android:height="31dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_switch_off" />
            <corners android:radius="15.5dp" />
            <size android:width="51dp" android:height="31dp" />
        </shape>
    </item>
</selector>
