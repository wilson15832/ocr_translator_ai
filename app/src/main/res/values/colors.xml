<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application colors -->
    <color name="primary">#4285F4</color>
    <color name="primary_dark">#3367D6</color>
    <color name="primary_variant">#5E97F6</color>
    <color name="secondary">#F4B400</color>
    <color name="secondary_dark">#E09600</color>
    <color name="secondary_variant">#F6C74E</color>

    <color name="background">#F2F2F7</color>
    <color name="surface">#FFFFFF</color>
    <color name="error">#B00020</color>
    <color name="on_surface_muted">#993C3C43</color>

    <!--
      iOS-style grouped-list palette (see the design doc's turn 2). Every name here has a
      values-night counterpart, so referencing these instead of raw hex is what makes the
      settings screens follow the system light/dark setting.
    -->
    <color name="ios_grouped_bg">#F2F2F7</color>
    <color name="ios_card">#FFFFFF</color>
    <color name="ios_separator">#C6C6C8</color>
    <color name="ios_label">#000000</color>
    <!-- Apple's secondaryLabel / tertiaryLabel: same hue, different alpha -->
    <color name="ios_label_secondary">#993C3C43</color>
    <color name="ios_label_tertiary">#4D3C3C43</color>
    <!-- secondarySystemFill — segmented-control track, inactive slider track -->
    <color name="ios_fill_secondary">#1F787880</color>
    <color name="ios_destructive">#FF3B30</color>
    <color name="ios_switch_on">#34C759</color>
    <color name="ios_switch_off">#E9E9EA</color>
    <color name="ios_switch_thumb">#FFFFFF</color>
    <color name="ios_segment_thumb">#FFFFFFFF</color>
    <!-- Live preview card in Overlay Settings — mimics the on-game overlay, so it stays dark -->
    <color name="ios_preview_bg">#1C1C1E</color>
    <!-- Opaque grey for the Overlay Settings glyph tile (on_surface_muted is translucent) -->
    <color name="glyph_tile_grey">#5F6368</color>

    <!--
      Accent palette behind the swatch row on the main screen. Each pairs with a
      ThemeOverlay.ScreenTranslator.AccentN in styles.xml, and each has a values-night variant
      lightened for contrast against a black background.
    -->
    <color name="accent_blue">#4285F4</color>
    <color name="accent_purple">#AF52DE</color>
    <color name="accent_green">#34C759</color>
    <color name="accent_orange">#FF9500</color>
    <color name="accent_pink">#FF375F</color>
    <color name="accent_graphite">#5F6368</color>

    <!--
      colorPrimaryVariant, used for the main screen's header band and its status bar. Each is
      dark enough to clear 4.5:1 against white, so the 15sp description on the band stays
      readable — the raw accents don't: white on accent_green/accent_orange is only ~2.2:1.
    -->
    <color name="accent_blue_dark">#2A5CC4</color>
    <color name="accent_purple_dark">#7B2FA3</color>
    <color name="accent_green_dark">#1E8637</color>
    <color name="accent_orange_dark">#9C5900</color>
    <color name="accent_pink_dark">#C21F40</color>
    <color name="accent_graphite_dark">#3A3D41</color>

    <!--
      colorOnPrimary for the darker accents. White works in the day build, but the night accents
      are lightened for a black background and then white fails on every one of them (night blue
      is 2.90:1, night pink 2.84:1) — hence the values-night override to dark.
    -->
    <color name="accent_on">#FFFFFF</color>
    <!-- For accents that are too light for white text in either build (green, orange) -->
    <color name="accent_on_light">#1A1A1A</color>

    <!--
      Home screen (design 8a/8b). Warm paper rather than the settings screens' cool grey, and no
      cards — the type and the hairlines carry the structure instead. The accent itself comes
      from the theme, so nothing accent-coloured is listed here.
    -->
    <color name="home_paper">#FBFAF7</color>
    <color name="home_text">#141414</color>
    <color name="home_value">#59000000</color>
    <color name="home_chevron">#38000000</color>
    <color name="home_footnote">#61000000</color>
    <color name="home_hairline">#17000000</color>
    <color name="home_rule">#1F000000</color>

    <color name="on_primary">#FFFFFF</color>
    <color name="on_secondary">#000000</color>
    <color name="on_background">#000000</color>
    <color name="on_surface">#000000</color>
    <color name="on_error">#FFFFFF</color>

    <!-- Translation overlay colors -->
    <color name="overlay_background">#E6222222</color>
    <color name="overlay_border">#44FFFFFF</color>
    <color name="translation_text_color">#FFFFFF</color>

    <!-- Control panel colors -->
    <color name="control_panel_background">#CC333333</color>
    <color name="divider_color">#33FFFFFF</color>

    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Add any additional colors your app uses -->
    <color name="light_gray">#FFDDDDDD</color>
    <color name="dark_gray">#FF333333</color>
    <color name="translucent_background">#80000000</color>

</resources>